{
  "c_prefix": "hc05",
  "c_source": "driver.c",
  "category": "rf",
  "datasheet": "https://www.electronicoscaldas.com/datasheet/HC-05.pdf",
  "default_address": "",
  "description": "Driver for HC-05 Bluetooth module using UART with extended AT command support.",
  "init_args": "{uart_id}",
  "interface": "uart",
  "params": {
    "baud": {
      "type": "int",
      "default": 9600
    }
  },
  "methods": {
    "send_at_command": {
      "description": "Sends an AT command to the HC-05 module.",
      "params": [
        {
          "name": "command",
          "type": "string"
        }
      ],
      "returns": "void"
    },
    "send_data": {
      "description": "Sends data over Bluetooth.",
      "params": [
        {
          "name": "data",
          "type": "int"
        }
      ],
      "returns": "void"
    },
    "set_baud_rate": {
      "description": "Sets the baud rate of the HC-05 module.",
      "params": [
        {
          "name": "baud_rate",
          "type": "int"
        }
      ],
      "returns": "void"
    },
    "set_name": {
      "description": "Set the module's Bluetooth name (AT mode).",
      "params": [
        {
          "name": "name",
          "type": "string"
        }
      ],
      "returns": "void"
    },
    "set_password": {
      "description": "Sets the password of the HC-05 module.",
      "params": [
        {
          "name": "password",
          "type": "string"
        }
      ],
      "returns": "void"
    },
    "send": {
      "description": "Send text over Bluetooth.",
      "params": [
        {
          "name": "text",
          "type": "string"
        }
      ],
      "returns": "void"
    },
    "send_line": {
      "description": "Send text followed by CR LF.",
      "params": [
        {
          "name": "text",
          "type": "string"
        }
      ],
      "returns": "void"
    },
    "available": {
      "description": "True when received bytes are waiting.",
      "params": [],
      "returns": "bool"
    },
    "read_line": {
      "description": "Next complete received line without CR/LF, or \"\" if none yet (never blocks).",
      "params": [],
      "returns": "string"
    }
  },
  "name": "HC05"
}

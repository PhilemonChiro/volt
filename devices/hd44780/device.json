  "specs": {
    "voltage": "5V (logic \u2014 3.3V works on some clones but contrast suffers)",
    "current": "1.5 mA logic + LED backlight (~20 mA per LED)",
    "interface": "4-bit or 8-bit parallel, or I\u00b2C via PCF8574 backpack",
    "characters": "16\u00d72, 16\u00d74, 20\u00d74 (controller is the same)"
  },
  "wiring": {
    "pins": [
      {
        "label": "VSS",
        "type": "ground",
        "note": "Logic ground"
      },
      {
        "label": "VDD",
        "type": "power",
        "note": "5V logic supply"
      },
      {
        "label": "V0",
        "type": "data",
        "note": "Contrast \u2014 wiper of a 10k\u03a9 pot"
      },
      {
        "label": "RS",
        "type": "data",
        "note": "Register select (cmd vs data)"
      },
      {
        "label": "RW",
        "type": "data",
        "note": "Tie LOW for write-only"
      },
      {
        "label": "E",
        "type": "clock",
        "note": "Enable pulse"
      },
      {
        "label": "D4-D7",
        "type": "data",
        "note": "Data lines (4-bit mode)"
      },
      {
        "label": "A/K",
        "type": "power",
        "note": "Backlight + / \u2212 with series resistor"
      }
    ]
  },
  "tips": [
    "Most hobby modules ship with a PCF8574 I\u00b2C backpack \u2014 much fewer pins. The Volt 'lcd16x2' / 'lcd20x4' drivers wrap this.",
    "Always include the 10k\u03a9 contrast pot \u2014 without it the display looks blank or has black blocks.",
    "Custom characters: 8 CGRAM slots, 5\u00d78 pixels each."
  ],
  "alternatives": [
    {
      "name": "SSD1306",
      "note": "128\u00d764 OLED \u2014 much more flexible, sharper, no contrast pot needed."
    }
  ]

{
  "name": "LCD20x4",
  "category": "display",
  "interface": "i2c",
  "default_address": "0x27",
  "description": "20x4 character LCD display (I2C backpack)",
  "c_prefix": "hd44780",
  "c_source": "",
  "init_args": "0, {addr}, 20, 4",
  "methods": {
    "clear": {
      "returns": "void",
      "params": [],
      "description": "Clear the display"
    },
    "print": {
      "returns": "void",
      "params": [
        {
          "name": "text",
          "type": "string"
        }
      ],
      "description": "Print text at cursor"
    },
    "set_cursor": {
      "returns": "void",
      "params": [
        {
          "name": "col",
          "type": "int"
        },
        {
          "name": "row",
          "type": "int"
        }
      ],
      "description": "Move cursor (col 0-19, row 0-3)"
    },
    "backlight": {
      "returns": "void",
      "params": [
        {
          "name": "on",
          "type": "int"
        }
      ],
      "description": "Toggle backlight on/off"
    }
  },
  "manufacturer": "Generic (HD44780 + PCF8574 backpack)",
  "datasheet": "https://www.sparkfun.com/datasheets/LCD/HD44780.pdf",
  "specs": {
    "voltage": "5V",
    "current": "1.5 mA + ~30 mA backlight",
    "characters": "20 columns \u00d7 4 rows",
    "interface_speed": "I\u00b2C up to 100 kHz"
  },
  "wiring": {
    "pins": [
      {
        "label": "VCC",
        "type": "power",
        "note": "3.3V or 5V"
      },
      {
        "label": "GND",
        "type": "ground",
        "note": ""
      },
      {
        "label": "SDA",
        "type": "data",
        "note": "Pull-up to VCC (often on breakout board)"
      },
      {
        "label": "SCL",
        "type": "clock",
        "note": "Pull-up to VCC"
      },
      {
        "label": "Backlight jumper",
        "type": "power",
        "note": "Pull to disable backlight"
      }
    ]
  },
  "tips": [
    "Line addressing isn't sequential \u2014 line 3 starts at column 0x00+0x14, line 4 at 0x40+0x14. Most drivers hide this.",
    "Drawing 80 chars over I\u00b2C at 100 kHz takes ~50 ms \u2014 avoid refreshing the whole screen every frame."
  ],
  "alternatives": [
    {
      "name": "SSD1306",
      "note": "OLED \u2014 smaller package but you get graphics."
    },
    {
      "name": "ST7789",
      "note": "Color TFT \u2014 more pixels, more flexibility, more code."
    }
  ]
}

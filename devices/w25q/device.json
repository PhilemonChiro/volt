      },
      {
        "label": "MISO",
        "type": "data",
        "note": "Master In / Slave Out"
      },
      {
        "label": "CS",
        "type": "data",
        "note": "Chip select (active low)"
      },
      {
        "label": "WP",
        "type": "data",

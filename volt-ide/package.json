{
  "name": "volt-ide",
  "version": "2.0.83",
  "description": "Volt IDE — declare hardware. Write logic. Flash.",
  "main": "main.js",
  "homepage": "https://github.com/PhilemonChiro/volt",
  "author": {
    "name": "Philemon Chiro",
    "email": "pchiro29@gmail.com"
  },
  "license": "AGPL-3.0-only",
  "type": "commonjs",
  "scripts": {
    "start": "electron . --no-sandbox",
    "dev": "electron . --dev --no-sandbox",
    "test:vlib": "node test/vlib/gen.js && node test/vlib/run.js",
    "test:trust": "node test/toolchain-trust.test.js",
    "postinstall": "node scripts/fix-sandbox.js && node scripts/dev-app-name.js",
    "stage:sdk": "node scripts/stage-sdk.js",
    "build:icons": "node scripts/build-icons.js",
    "build:volt": "node scripts/build-volt.js",
    "publish:toolchain-manifest": "node scripts/publish-toolchain-manifest.js",
    "prepack": "npm run stage:sdk && npm run build:icons",
    "pack:linux": "npm run prepack && npm run build:volt -- linux-x64 && electron-builder --linux",
    "pack:win": "npm run prepack && npm run build:volt -- win32-x64 && electron-builder --win",
    "pack:mac": "npm run prepack && npm run build:volt -- darwin-arm64 darwin-x64 && electron-builder --mac",
    "pack:all": "npm run prepack && npm run build:volt -- linux-x64 win32-x64 && electron-builder --linux --win",
    "release:ide": "sh scripts/release-ide.sh"
  },
  "devDependencies": {
    "electron": "^41.2.0",
    "electron-builder": "^26.8.1",
    "png-to-ico": "^3.0.1",
    "sharp": "^0.34.5"
  },
  "build": {
    "appId": "dev.volt.ide",
    "productName": "Volt IDE",
    "copyright": "Copyright © 2026 Philemon Chiro",
    "protocols": [
      {
        "name": "Volt Library",
        "schemes": [
          "volt"
        ]
      }
    ],
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "assets/**",
      "lib/**",
      "scripts/**",
      "bin/**",
      "src/**",
      "package.json",
      "!**/*.{md,log}",
      "!**/.DS_Store",
      "!**/__pycache__/**"
    ],
    "asarUnpack": [
      "scripts/**/*",
      "bin/**/*"
    ],
    "extraResources": [
      {
        "from": "sdk",
        "to": "sdk",
        "filter": [
          "**/*",
          "!**/__pycache__/**",
          "!**/*.pyc"
        ]
      }
    ],
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Development",
      "icon": "build/icon.png",
      "synopsis": "Declare hardware. Write logic. Flash.",
      "description": "Volt IDE — write embedded firmware as plain readable programs and flash them to ESP32, RP2040, and more.",
      "maintainer": "Philemon Chiro <pchiro29@gmail.com>"
    },
    "deb": {
      "depends": [
        "libnotify4",
        "libgconf-2-4 | libgconf2-4"
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Volt IDE"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.icns",
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    },
    "fileAssociations": [
      {
        "ext": "volt",
        "name": "Volt Source",
        "description": "Volt program",
        "role": "Editor",
        "mimeType": "text/x-volt"
      }
    ],
    "publish": [
      {
        "provider": "generic",
        "url": "https://dl.voltembedded.com/ide",
        "channel": "latest"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}

{
  "name": "volt-ide",
  "version": "2.0.8",
  "description": "Volt IDE — embedded development that reads like English",
  "main": "main.js",
  "homepage": "https://github.com/pchiro/volt",
  "author": {
    "name": "Philemon Chiro",
    "email": "pchiro29@gmail.com"
  },
  "license": "MIT",
  "type": "commonjs",
  "scripts": {
    "start": "electron . --no-sandbox",
    "dev": "electron . --dev --no-sandbox",
    "stage:sdk":      "node scripts/stage-sdk.js",
    "build:icons":    "node scripts/build-icons.js",
    "bundle:python":  "node scripts/bundle-python.js",
    "prepack":        "npm run stage:sdk && npm run build:icons",
    "pack:linux":     "npm run prepack && npm run bundle:python && electron-builder --linux",
    "pack:win":       "npm run prepack && npm run bundle:python && electron-builder --win",
    "pack:mac":       "npm run prepack && npm run bundle:python && electron-builder --mac",
    "pack:all":       "npm run prepack && npm run bundle:python && electron-builder --linux --win"
  },
  "dependencies": {
    "@serialport/parser-readline": "^13.0.0",
    "serialport": "^13.0.0"
  },
  "devDependencies": {
    "electron": "^41.2.0",
    "electron-builder": "^26.8.1",
    "png-to-ico": "^3.0.1",
    "sharp": "^0.34.5"
  },
  "build": {
    "appId": "dev.volt.ide",
    "productName": "Volt IDE",
    "copyright": "Copyright © 2026 Philemon Chiro",
    "afterPack": "scripts/afterPack.js",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "assets/**",
      "lib/**",
      "scripts/**",
      "src/**",
      "package.json",
      "!**/*.{md,log}",
      "!**/.DS_Store",
      "!**/__pycache__/**"
    ],
    "asarUnpack": [
      "scripts/**/*"
    ],
    "extraResources": [
      {
        "from": "sdk",
        "to": "sdk",
        "filter": [
          "**/*",
          "!**/__pycache__/**",
          "!**/*.pyc"
        ]
      }
    ],
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Development",
      "icon": "build/icon.png",
      "synopsis": "Embedded development that reads like English",
      "description": "Volt IDE — write embedded firmware as plain readable programs and flash them to ESP32, RP2040, and more.",
      "maintainer": "Philemon Chiro <pchiro29@gmail.com>"
    },
    "deb": {
      "depends": [
        "python3 (>= 3.10)",
        "python3-lark",
        "libnotify4",
        "libgconf-2-4 | libgconf2-4"
      ]
    },
    "win": {
      "target": [
        { "target": "portable", "arch": ["x64"] }
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Volt IDE"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.icns",
      "hardenedRuntime": false
    }
  }
}

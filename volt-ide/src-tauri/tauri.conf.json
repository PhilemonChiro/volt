{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Volt IDE",
  "version": "0.1.0",
  "identifier": "com.volt.ide.v1775991419",
  "build": {
    "frontendDist": "../src",
    "beforeBuildCommand": "npm run build",
    "beforeDevCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Volt IDE",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "decorations": false
      }
    ],
    "withGlobalTauri": true,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}

{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Volt IDE",
  "version": "0.1.0",
  "identifier": "com.volt.ide",
  "build": {
    "frontendDist": "../dist-frontend",
    "beforeBuildCommand": "npm run package",
    "beforeDevCommand": "npm run package"
  },
  "app": {
    "windows": [
      {
        "title": "Volt IDE",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self' blob: data:; script-src 'self' 'unsafe-inline' blob:; style-src 'self' 'unsafe-inline'; worker-src 'self' blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}

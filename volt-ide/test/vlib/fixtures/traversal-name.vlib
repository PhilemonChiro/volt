{
  "schema": 1,
  "manifest": {
    "name": "GoldTest",
    "prefix": "goldtest",
    "version": "1.0.0",
    "interface": "i2c",
    "capabilities": [
      "i2c"
    ],
    "author": "gh:test",
    "trustTier": "verified"
  },
  "device": {
    "name": "GoldTest",
    "category": "sensor",
    "interface": "i2c",
    "default_address": "0x40",
    "description": "golden fixture",
    "c_prefix": "../evil",
    "c_source": "driver.c",
    "init_args": "{bus_id}, {addr}",
    "methods": {
      "read": {
        "returns": "float",
        "params": []
      }
    }
  },
  "driver": {
    "common": "volt_error_t goldtest_init(goldtest_t*d,uint8_t bus_id,uint8_t addr){d->bus_id=bus_id;d->addr=addr;return VOLT_OK;}\nfloat goldtest_read(goldtest_t*d){return (float)volt_i2c_read_reg16(d->bus_id,d->addr,0);}"
  },
  "header": {
    "struct_name": "goldtest_t",
    "fields": [
      [
        "bus_id",
        "uint8_t"
      ],
      [
        "addr",
        "uint8_t"
      ]
    ],
    "init_params": [
      [
        "bus_id",
        "uint8_t"
      ],
      [
        "addr",
        "uint8_t"
      ]
    ],
    "methods": [
      {
        "name": "read",
        "ret": "float",
        "params": []
      }
    ]
  },

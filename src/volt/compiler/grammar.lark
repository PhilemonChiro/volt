// ============================================================
// Volt Language Grammar v2 (Lark LALR(1))
//
// A typed, hardware-aware language for embedded systems.
// Transpiles to C targeting ESP32, RP2040, STM32.
//
// Program structure:
//   chip → hardware → setup (runs once) → loop OR tasks/machines
// ============================================================


// --- Top Level ---

start: (_NL | top_level)*

?top_level: chip_decl
    | include_decl
    | hardware_block
    | power_block
    | struct_decl
    | enum_decl
    | func_decl
    | task_decl
    | machine_decl
    | setup_block
    | loop_block
    | raw_block
    | storage_decl _NL
    | var_decl _NL
    | channel_decl _NL
    | every_block
    | on_block


// --- Chip Declaration ---
// chip esp32

chip_decl: "chip" NAME _NL


// --- Include (file inclusion) ---
// include "sensors.volt"

include_decl: "include" ESCAPED_STRING _NL


// --- Hardware Block ---
// hardware { pin led: Output = 2 ... }

hardware_block: "hardware" "{" (_NL | hardware_item)* "}"

?hardware_item: pin_decl _NL
    | bus_decl _NL
    | sensor_decl _NL

pin_decl: "pin" NAME ":" pin_mode "=" expr

pin_mode: NAME ("." NAME)*

bus_decl: "bus" NAME ":" NAME "(" named_args? ")"

sensor_decl: "device" NAME ":" NAME "on" NAME "at" expr


// --- Power Block (for compile-time power estimation) ---

power_block: "power" "{" (_NL | power_item)* "}"

power_item: NAME ":" power_value _NL

power_value: NAME "(" arg_list ")"
    | NAME


// --- Struct ---
// struct Reading { temperature: float ... }

struct_decl: "struct" NAME "{" (_NL | struct_field)* "}"

struct_field: NAME ":" type_name _NL

// --- Enum ---
// enum Color { red, green, blue }  or  enum Color { red\n green\n blue }
enum_decl: "enum" NAME "{" enum_body "}"
enum_body: (_NL | enum_variant)*
enum_variant: NAME ","?  _NL?


// --- Function ---
// func average(a: float, b: float) -> float { ... }

func_decl: "func" NAME "(" param_list? ")" return_type? block

return_type: "->" type_name

param_list: param ("," param)*

param: NAME ":" type_name


// --- Task ---
// task blink { every 500ms { led.toggle() } }

task_decl: TASK_ANNOTATION* "task" NAME block

TASK_ANNOTATION: /@(critical|priority|core\([01]\))/


// --- State Machine ---
// machine DeviceState { var retry = 0  state idle { ... } }

machine_decl: "machine" NAME "{" (_NL | machine_item)* "}"

?machine_item: state_decl
    | var_decl _NL

state_decl: INITIAL? "state" NAME "{" (_NL | state_item)* "}"

INITIAL: "initial"

?state_item: state_enter
    | state_exit
    | state_on _NL
    | state_after _NL
    | statement

state_enter: "enter" block
state_exit: "exit" block

state_on: "on" expr state_guard? "->" NAME state_action?

state_after: "after" expr state_guard? "->" NAME state_action?

state_guard: "[" expr "]"

state_action: block


// --- Storage Declaration ---
// storage boot_count: int = 0

storage_decl: "storage" NAME ":" type_name "=" expr


// --- Setup Block (runs once at boot) ---

setup_block: "setup" block


// --- Loop Block (v2: super-loop, runs forever) ---
// loop { led.toggle(); sleep(500ms) }

loop_block: "loop" block


// --- Raw C Block ---

raw_block: "raw" "{" ESCAPED_STRING "}"


// --- Block ---

block: "{" (_NL | statement)* _inline_stmt? "}"

// Single statement on same line as braces: { stmt }
// These don't require a trailing _NL before the }
_inline_stmt: var_decl
    | return_stmt
    | assign_stmt
    | expr_stmt
    | break_stmt
    | continue_stmt


// --- Statements ---
// _NL is required between consecutive statements.
// _NL? at the end allows single-line blocks: { stmt }

?statement: var_decl _NL
    | return_stmt _NL
    | assign_stmt _NL
    | expr_stmt _NL
    | if_stmt
    | while_stmt
    | for_stmt
    | loop_stmt
    | match_stmt
    | every_block
    | on_block
    | timeout_block
    | break_stmt _NL
    | continue_stmt _NL

var_decl: VAR_KEYWORD NAME type_annotation? "=" expr
    | "shared" VAR_KEYWORD NAME type_annotation? "=" expr -> shared_var_decl

VAR_KEYWORD.4: "let" | "var"

type_annotation: ":" type_name

// Channel declaration: channel name: int  or  channel name: int[16]
channel_decl: "channel" NAME ":" type_name
    | "channel" NAME ":" type_name "[" INT "]"

return_stmt: "return" expr?

// Compound assignment: count += 1, mask |= 0x04
assign_stmt: postfix ASSIGN_OP expr

ASSIGN_OP.3: "+=" | "-=" | "*=" | "/=" | "%=" | "&=" | "|=" | "^=" | "<<=" | ">>="

expr_stmt: expr

if_stmt: "if" expr block else_clause?

else_clause: "else" if_stmt
    | "else" block

while_stmt: "while" expr block

// For loop: for i in 0..10 { ... }  or  for i in 0..100 step 5 { ... }
for_stmt: "for" NAME "in" expr ".." expr step_clause? block

step_clause: "step" expr

// Infinite loop: loop { ... break ... }
loop_stmt: "loop" block

// Break and continue
break_stmt: "break"
continue_stmt: "continue"

every_block: "every" expr STRICT? block

STRICT: "strict"

// Event handler: on button.press() debounce 50ms { ... }
on_block: "on" expr debounce_clause? throttle_clause? block

debounce_clause: "debounce" expr

throttle_clause: "throttle" expr

// Timeout: timeout 10s { try } else { fallback }
// v1 compat: timeout 10s { try } { fallback }
timeout_block: "timeout" expr block TIMEOUT_ELSE? block

TIMEOUT_ELSE.5: "else"

// Match: match(state) { .idle -> ... .active -> ... }
match_stmt: "match" "(" expr ")" "{" (_NL | match_arm)* "}"

match_arm: match_pattern "->" match_body _NL

// v2: match on .name, integer literals, ranges
?match_pattern: "." NAME -> match_name
    | INT -> match_int
    | INT ".." INT -> match_range
    | "_" -> match_wildcard

?match_body: expr
    | block


// --- Expressions (precedence: lowest to highest) ---

?expr: assign_expr

// Assignment: x = 5
?assign_expr: or_expr
    | postfix "=" or_expr -> assign_op

// Boolean OR
?or_expr: and_expr
    | or_expr "||" and_expr -> or_op

// Boolean AND
?and_expr: comparison
    | and_expr "&&" comparison -> and_op

// Comparison
?comparison: bitwise_or
    | comparison COMP_OP bitwise_or -> comp_op
    | comparison LESSTHAN bitwise_or -> comp_lt
    | comparison GREATERTHAN bitwise_or -> comp_gt

COMP_OP: "==" | "!=" | "<=" | ">="
LESSTHAN: "<"
GREATERTHAN: ">"

// Bitwise OR
?bitwise_or: bitwise_xor
    | bitwise_or VBAR bitwise_xor -> bitor_op

VBAR: "|"

// Bitwise XOR
?bitwise_xor: bitwise_and
    | bitwise_xor CIRCUMFLEX bitwise_and -> bitxor_op

CIRCUMFLEX: "^"

// Bitwise AND
?bitwise_and: shift
    | bitwise_and AMPERSAND shift -> bitand_op

AMPERSAND: "&"

// Bit shift
?shift: addition
    | shift SHL addition -> shl_op
    | shift SHR addition -> shr_op

SHL.2: "<<"
SHR.2: ">>"

// Addition / subtraction
?addition: multiplication
    | addition "+" multiplication -> add_op
    | addition "-" multiplication -> sub_op

// Multiplication / division / modulo
?multiplication: unary
    | multiplication "*" unary -> mul_op
    | multiplication "/" unary -> div_op
    | multiplication "%" unary -> mod_op

// Unary operators
?unary: "!" unary -> not_expr
    | "-" unary -> neg_expr
    | "~" unary -> bitnot_expr
    | postfix

// Postfix: field access, method calls, function calls, or-fallback
?postfix: primary
    | postfix "." NAME -> dot_access
    | postfix "(" arg_list? ")" -> func_call
    | postfix "or" or_fallback -> or_expr

or_fallback: "skip" -> or_skip
    | "restart" -> or_restart
    | "retry" "(" expr ")" -> or_retry
    | expr -> or_default

// Primary expressions
?primary: DURATION -> duration_lit
    | FLOAT -> float_lit
    | HEX_INT -> hex_lit
    | BIN_INT -> bin_lit
    | INT -> int_lit
    | ESCAPED_STRING -> string_lit
    | "true" -> true_lit
    | "false" -> false_lit
    | NAME -> var_ref
    | "(" expr ")"
    | array_literal

// Array literal: [1, 2, 3]
array_literal: "[" (expr ("," expr)*)? "]"

// Duration token: 500ms, 5s, 1sec, 10min, 1hr, 100us
// Accepts: us, ms, s, sec, second, seconds, min, minute, minutes, hr, hour, hours
DURATION.3: /[0-9]+(\.[0-9]+)?(us|ms|seconds|second|sec|minutes|minute|min|hours|hour|hr|s)/

// Numeric literals
FLOAT.2: /[0-9]+\.[0-9]+/
HEX_INT.2: /0x[0-9a-fA-F]+/
BIN_INT.2: /0b[01_]+/
INT.1: /[0-9]+/

// Arguments
arg_list: expr ("," expr)*

named_args: named_arg ("," named_arg)*

named_arg: NAME ":" expr


// --- Type Names ---
// v2: supports u8, u16, u32, i8, i16, i32 as built-in type names

?type_name: NAME -> simple_type
    | NAME "<" type_name ">" -> generic_type
    | NAME "<" INT ">" -> sized_type


// --- Tokens ---

NAME: /[a-zA-Z_][a-zA-Z0-9_]*/

%import common.ESCAPED_STRING

_NL: NEWLINE+
NEWLINE: /\r?\n/

%ignore /[ \t]+/
// Line comments
%ignore /\/\/[^\n]*/
// Block comments
%ignore /\/\*[\s\S]*?\*\//
